        "m_Metadata": {
          "m_Items": {
            "Array": []
          }
        }
      },
      {
        "m_Id": 99687405486993408,
        "m_Localized": "Combine items using the Inventory screen. \n\nCombined healing items for a more potent effect and to free up item space in inventory.",
